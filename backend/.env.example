# Copie para .env (ou exporte no ambiente) e ajuste. Nenhum valor aqui é secreto.
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# True só em desenvolvimento
DEBUG=True
# Hosts aceitos, separados por vírgula (".onrender.com" aceita qualquer subdomínio do Render)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# CORS: True libera qualquer origem (padrão). Para restringir, False + lista de origens.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
